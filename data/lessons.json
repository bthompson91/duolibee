ipino"},{"t":"Ingles","e":"English"},{"t":"Tagalog","e":"Tagalog"},{"t":"nag-aaral","e":"studying"},{"t":"guro","e":"teacher"},{"t":"maganda","e":"beautiful"},{"t":"masaya","e":"happy"}],"sentences":[{"t":"Ako si Ana.","e":"I am Ana.","speaker":"lumpy"},{"t":"Anong pangalan mo?","e":"What is your name?","speaker":"jetjet"},{"t":"Taga-Australia ako.","e":"I am from Australia.","speaker":"lumpy"}]},{"name":"Family","icon":"👨‍👩‍👧","host":"lola-joli","intro":"Halika, apo! Lola Joli here — family is everything in the Philippines, so let's learn the words for the people you love most.","items":[{"t":"pamilya","e":"family"},{"t":"nanay","e":"mother"},{"t":"tatay","e":"father"},{"t":"kapatid","e":"sibling"},{"t":"kuya","e":"older brother"},{"t":"ate","e":"older sister"},{"t":"lolo","e":"grandfather"},{"t":"lola","e":"grandmother"},{"t":"anak","e":"child"},{"t":"asawa","e":"spouse"},{"t":"pamilya ko","e":"my family"},{"t":"mabait","e":"kind"}],"sentences":[{"t":"Malaki ang pamilya ko.","e":"My family is big.","speaker":"lola-joli"},{"t":"Mabait ang nanay ko.","e":"My mother is kind.","speaker":"jetjet"},{"t":"Mahal ko ang pamilya ko.","e":"I love my family.","speaker":"tita-baby"}]},{"name":"Food Basics","icon":"🍚","host":"lola-joli","intro":"Lola Joli's kitchen is open! Rice, chicken, fish — let's learn the words, and then we'll eat. Gutom ka na ba?","items":[{"t":"pagkain","e":"food"},{"t":"kanin","e":"cooked rice"},{"t":"tinapay","e":"bread"},{"t":"itlog","e":"egg"},{"t":"karne","e":"meat"},{"t":"manok","e":"chicken"},{"t":"baboy","e":"pork"},{"t":"isda","e":"fish"},{"t":"gulay","e":"vegetables"},{"t":"prutas","e":"fruit"},{"t":"masarap","e":"delicious"},{"t":"Gutom ako","e":"I am hungry"}],"sentences":[{"t":"Gutom ako.","e":"I am hungry.","speaker":"jetjet"},{"t":"Kumakain ako ng kanin.","e":"I am eating rice.","speaker":"tito-bong"},{"t":"Masarap ang pagkain.","e":"The food is delicious.","speaker":"lola-joli"}]},{"name":"Drinks & Fruit","icon":"💧","host":"tita-baby","i